<?xml version="1.0" encoding="utf-8"?>
<!-- Starting window before Android 12 (API 31+ uses the system splash screen
     declared in values-v31/styles.xml): brand black with the badge centred at
     96dp. Identical to drawable-v21/launch_background.xml, which is the one
     that resolves on minSdk 24; kept so the Flutter template layout stays. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background"/>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo"/>
    </item>
</layer-list>
