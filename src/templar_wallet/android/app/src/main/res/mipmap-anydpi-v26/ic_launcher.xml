<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon on API 26+. The legacy mipmap-*dpi/ic_launcher.png (the full
     badge) is what API 24–25 draws. Foreground and monochrome are generated by
     scripts/generate_icons.sh from assets/brand/templar-cross.svg. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@drawable/ic_launcher_monochrome"/>
</adaptive-icon>
